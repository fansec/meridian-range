# Copy to .env on the VM. BENIGN LAB VALUES ONLY - never a real secret. .env is git-ignored.
#
# THIS FILE IS FOR DEPLOYMENT, NOT FOR SCENARIOS. It holds only values that genuinely differ per
# deployment: published ports and host addresses. A module's own targets live in its
# modules/<NN-slug>/lab.env, which is committed (lab role names, not secrets) and loaded into the
# harness by that module's compose.yml. That split is why this file no longer grows a section every
# time a module is added.
#
# ONE VOCABULARY IN EVERY TIER (decision, 2026-08-02). The role names below are the same ones the
# sealed tier uses and the same ones that appear in the published clips. The sealed tier resolves
# them as labnet aliases on an `internal: true` network rather than through your DNS, so it still
# needs no DNS record and still publishes no port; it simply stopped speaking a second, private set
# of names (mcp-ci.labnet, evil.example) for the same three roles.
#
# So nothing here is needed for the SEALED tier, which is the default and the definition-of-done
# gate. These variables matter only for the opt-in exposed tiers and for `range traefik`.
#
# Organised by ROLE, not by module. The range deploys one module at a time, so
# every module reuses the same roles instead of adding names, and one wildcard DNS record covers all
# of them. Each module declares which roles it uses in its module.yml `topology.roles`.
#
#   ROLE       what it is                      public name knob       port knob
#   mcp        the victim MCP under test       PUBLIC_MCP_HOST        MCP_PORT
#   hacker     the attacker's drive-by page    PUBLIC_HACKER_HOST     WEB_PORT
#   collector  the exfil sink                  PUBLIC_COLLECTOR_HOST  COLLECTOR_PORT
#   rebind     the name that flips             LAB_REBIND_HOST        REBIND_HTTP_PORT

# ---- where the hosts are (needed by any exposed tier) ------------------------------------------
# LAB_VM_IP: where the capability-bearing victim MCP runs, always.
# ATTACKER_HOST_IP: the sanctioned attacker host, static page + sink only, never a tool-bearing one.
# Set them APART for split-host; make them EQUAL for single-host. These are RFC 5737 documentation
# addresses: REPLACE both. Real addresses live only in .env, never in the committed repo, and never
# in a published screenshot or recording.
LAB_VM_IP=192.0.2.10
ATTACKER_HOST_IP=198.51.100.10

# Where `range sync` pushes. Also deliberately uncommitted.
# LAB_VM=ai@192.0.2.10
# LAB_VM_PATH=~/meridian-range/

# ---- public role names + published ports (exposed tiers only) -----------------------------------
# Keep each name matched to its ROLE: the CORS hijack is cross-origin, so attacker.* calling mcp.* is
# the point, and a collector routed under some other name will not match the page's target.
PUBLIC_MCP_HOST=mcp.lab.consulereit.nl
PUBLIC_HACKER_HOST=attacker.lab.consulereit.nl
PUBLIC_COLLECTOR_HOST=collector.lab.consulereit.nl
WEB_PORT=1337
MCP_PORT=8080
COLLECTOR_PORT=9000

# ---- Traefik knobs (OPTIONAL; drive `range traefik <module>`) ------------------------------------
# VERIFY the entrypoint and resolver against YOUR Traefik - these are common defaults, not a read of
# your install. Leave TRAEFIK_CERTRESOLVER blank to emit plain-HTTP routers with no tls block.
# ONE fixed router prefix, not one per module: Traefik names are a flat global namespace, and since
# only one module is deployed at a time, one generated file serves whichever is up. `grep mr-` over
# your dynamic config then shows everything the lab currently exposes.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le
TRAEFIK_ROUTER_PREFIX=mr

# ---- module 02 only: the rebind name and its port ------------------------------------------------
# split-host only, two hosts, using your existing lab DNS (no bundled DNS by default). The rebind
# name's ANSWER must change over time; a fixed wildcard record is not enough. Both sides publish the
# SAME port on different hosts. See modules/02-dns-rebind/README.md.
LAB_REBIND_HOST=rebind.lab.consulereit.nl
REBIND_HTTP_PORT=8080
# VICTIM_HTTP_PORT defaults to REBIND_HTTP_PORT; keep them equal.

# ALLOWED_HOSTS feeds the `foreign_host` detection signal. The rebind host is deliberately absent.
# ENABLE_DNS_REBIND_PROTECTION turns that allow-list from telemetry into an enforced control; it is
# 0 by default because that is how the SDK ships (`range matrix 02` flips it).
ALLOWED_HOSTS=mcp.lab.consulereit.nl,localhost,127.0.0.1
ENABLE_DNS_REBIND_PROTECTION=0
