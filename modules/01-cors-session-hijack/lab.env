# Module 01 sealed-tier targets. Committed on purpose: these are the lab's own role names, which
# resolve only on the isolated lab LAN and never on the internet, and none of them is a secret.
# Loaded into the harness container by ./compose.yml. Override any of them for one run by exporting
# the variable before `range run 01` (the CLI forwards LAB_* / MCP_* / MERIDIAN_* through as -e).
#
# One vocabulary in every tier (decision, 2026-08-02). The sealed tier used to speak in Docker
# aliases (mcp-ci.labnet) and a reserved placeholder (evil.example) while the exposed tiers and the
# published clips used the lab's real names, so a reader had to translate between two sets of names
# for the same three roles. The names below are now the real ones, and each module's compose.yml
# publishes them as labnet aliases so they still resolve inside the sealed network. labnet stays
# `internal: true`, so these resolve to the containers and can never reach real lab infrastructure.
#
# Only deployment-specific values (published ports, host addresses) live in the repo-root .env,
# because those genuinely differ per deployment. See .env.example.

# MCP_TARGET_URL is the one name every module uses for "the victim MCP", so the SDK resolves a target
# the same way for all of them. For the http+sse transport it is the server BASE url.
MCP_TARGET_URL=http://mcp.lab.consulereit.nl:8080
MCP_SSE_PATH=/mcp/sse
MCP_MESSAGE_PATH=/mcp/message

# LAB_EVIL_ORIGIN is only an Origin header value the scenario forges: nothing has to resolve it for
# the sealed run to work. It carries the same name the exposed tiers serve the drive-by page on
# (PUBLIC_HACKER_HOST), so the Origin in a sealed run reads like the one in the published clip. It is
# https here because that is what a browser sends once Traefik terminates TLS in front of the page.
LAB_EVIL_ORIGIN=https://attacker.lab.consulereit.nl
LAB_COLLECTOR_URL=http://collector.lab.consulereit.nl:9000/pwned
LAB_CANARY_PREFIX=LAB_CANARY
