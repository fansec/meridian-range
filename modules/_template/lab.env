# Module {{ID}} sealed-tier targets, loaded into the harness container by ./compose.yml.
#
# Committed on purpose: every value here is one of the lab's own role names, which resolve only on
# the isolated lab LAN and never on the internet, and none of them is a secret. Use the real role
# names rather than inventing a placeholder: the sealed tier, the exposed tiers and the published
# clips all speak the same vocabulary (see modules/01-cors-session-hijack/lab.env). Your module's
# compose.yml publishes the victim's name as a labnet alias so it resolves inside the sealed network.
# Deployment-specific values (published ports, host addresses) belong in the repo-root .env instead.
#
# Override any of these for a single run by exporting the variable before `range run {{ID}}`.

# The victim MCP. For http+sse this is the server BASE url; for streamable-http, the full endpoint.
MCP_TARGET_URL=http://mcp.lab.consulereit.nl:8080/mcp

LAB_COLLECTOR_URL=http://collector.lab.consulereit.nl:9000/pwned
LAB_CANARY_PREFIX=LAB_CANARY

# Uncomment the one this attack needs:
# LAB_EVIL_ORIGIN=https://attacker.lab.consulereit.nl       # a forged browser Origin (cross-origin attacks)
# LAB_REBIND_HOST=rebind.lab.consulereit.nl         # a forged Host header (name-confusion attacks)
